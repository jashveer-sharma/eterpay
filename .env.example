# ==========================================
# EterPay Environment Variables (Template)
# Copy this file to .env and fill in values
# NEVER COMMIT .env TO VERSION CONTROL
# ==========================================

# 1. PayPal Developer Sandbox Credentials
# Get these from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id_here

# 2. Free AI API Credentials
# Google Gemini 1.5 Flash (Google AI Studio - 100% Free): https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud Llama 3.3 70B (Groq Console - 100% Free Fallback): https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# 3. Agentic Commerce (Channel3)
# Register at: https://trychannel3.com (Promo: PAYPAL-HACKATHON-2026)
CHANNEL3_API_KEY=your_channel3_api_key_here

# 4. Backend & Database Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3000
DATABASE_URL=sqlite:///./eterpay.db
# For production PostgreSQL on Render:
# DATABASE_URL=postgresql://user:pass@host/eterpay
