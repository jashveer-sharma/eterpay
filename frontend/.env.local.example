# ============================================================
# EterPay Frontend — Environment Variables Template
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git.
# ============================================================

# --- PayPal Sandbox Client ID (PUBLIC — safe to expose in browser) ---
# Must match the PAYPAL_CLIENT_ID in backend/.env
# From: developer.paypal.com > My Apps & Credentials
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_sandbox_client_id_here

# --- Backend API URL (optional — defaults to relative /api via Next.js rewrite) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000
