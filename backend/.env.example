# ============================================================
# EterPay Backend — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ============================================================

# --- Project ---
PROJECT_NAME=EterPay
ENVIRONMENT=development

# --- PayPal Sandbox (developer.paypal.com > My Apps & Credentials) ---
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id_here

# --- AI Keys (Free Tier) ---
# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Groq Console (optional fallback): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Channel3 Commerce API (optional) ---
CHANNEL3_API_KEY=your_channel3_key_here

# --- Financial Safety Limits ---
MAX_SINGLE_ORDER_INR=25000.00
MAX_SINGLE_ORDER_USD=300.00

# --- Database (SQLite default, switch to PostgreSQL for production) ---
DATABASE_URL=sqlite+aiosqlite:///./eterpay.db

# --- Rates (Frankfurter ECB — no key required, leave as-is) ---
FRANKFURTER_BASE_URL=https://api.frankfurter.app
