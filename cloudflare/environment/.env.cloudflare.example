# Cloudflare Environment Variables Template
# Copy this file, fill in values, then run 05-configure-secrets.ps1
# NEVER commit a file with real values to git.

# Cloudflare API Token (restricted, not Global API Key)
# Generate at: https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare Account ID
CF_ACCOUNT_ID=e233b39f3904bf6467d237c883cdd381

# Cloudflare Pages Project Name
CF_PAGES_PROJECT=eterpay

# Cloudflare D1 Database ID (after creating with 04-setup-database.ps1)
CF_D1_DATABASE_ID=

# EterPay Backend URL (public URL of the FastAPI backend)
NEXT_PUBLIC_BACKEND_URL=https://eterpay-api.onrender.com

# PayPal Sandbox Client ID (safe to expose in frontend)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=AarBKUm2Az4FwM5TuvFFmrtDekBxpj5UN6_O5LRQ6Bw-_CfjeuTCVIVbuLg7JShbigWWkuWKHuRLILQI
